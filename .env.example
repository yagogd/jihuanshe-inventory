# Copia este archivo a `.env` y ajusta los valores que necesites.
# El orden de prioridad es: variables de entorno > .env > valores por defecto.

# Ruta al ejecutable adb (Android Platform Tools).
# Opcional si adb ya está en el PATH del sistema.
JIHUANSHE_ADB=C:\Android\platform-tools\adb.exe

# Directorio donde se guardan la base de datos, imágenes y dumps (opcional).
# JIHUANSHE_DATA_DIR=

# Comisión Alipay: umbral (en fen, 1 yuan = 100 fen) y tasa (fracción).
# JIHUANSHE_ALIPAY_THRESHOLD_FEN=20000
# JIHUANSHE_ALIPAY_RATE=0.03

# FX CNY -> EUR por defecto para órdenes nuevas.
# JIHUANSHE_FX_CNY_EUR=0.13

# Recortar imágenes de las cartas (1 = sí, 0 = no).
# JIHUANSHE_CAPTURE_IMAGES=1

# Máximo de scrolls al capturar una orden.
# JIHUANSHE_MAX_SCROLLS=80

# Traducir automáticamente los nombres chinos al inglés (1 = sí, 0 = no).
# Requiere conexión; si falla, la carta se guarda sin nombre en inglés.
# JIHUANSHE_AUTO_TRANSLATE=1
